C4Container
  title Containers: Online Boutique (from kubernetes-manifests)
  Person(customer, "Customer", "Shops via a web browser")
  System_Boundary(boutique, "Online Boutique") {
    Container(frontend, "frontend", "HTTP server", "Web entry point; calls backends")
    Container(checkout, "checkoutservice", "gRPC", "Places orders")
    Container(cart, "cartservice", "gRPC", "Shopping cart")
    ContainerDb(redis, "redis-cart", "Redis", "Cart data, emptyDir volume")
    Container(catalog, "productcatalogservice", "gRPC", "Product catalog")
    Container(currency, "currencyservice", "gRPC", "Currency")
    Container(recommendation, "recommendationservice", "gRPC", "Recommendations")
    Container(shipping, "shippingservice", "gRPC", "Shipping")
    Container(payment, "paymentservice", "gRPC", "Payment")
    Container(email, "emailservice", "gRPC", "Email")
    Container(ad, "adservice", "gRPC", "Ads")
    Container(loadgen, "loadgenerator", "Load generator", "Synthetic traffic; optional")
  }
  Rel(customer, frontend, "Browses and buys", "HTTP")
  Rel(loadgen, frontend, "Sends synthetic traffic", "HTTP")
  Rel(frontend, catalog, "Calls", "gRPC")
  Rel(frontend, currency, "Calls", "gRPC")
  Rel(frontend, cart, "Calls", "gRPC")
  Rel(frontend, recommendation, "Calls", "gRPC")
  Rel(frontend, shipping, "Calls", "gRPC")
  Rel(frontend, checkout, "Calls", "gRPC")
  Rel(frontend, ad, "Calls", "gRPC")
  Rel(checkout, catalog, "Calls", "gRPC")
  Rel(checkout, shipping, "Calls", "gRPC")
  Rel(checkout, payment, "Calls", "gRPC")
  Rel(checkout, email, "Calls", "gRPC")
  Rel(checkout, currency, "Calls", "gRPC")
  Rel(checkout, cart, "Calls", "gRPC")
  Rel(recommendation, catalog, "Calls", "gRPC")
  Rel(cart, redis, "Reads/writes", "Redis TCP")
  UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")